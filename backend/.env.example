MONGO_URI=your_mongodb_uri
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
# Optional separate AES-256-GCM key for short-lived mobile onboarding data.
# Keep it server-side. If omitted, a key is derived from JWT_ACCESS_SECRET.
AUTH_DATA_ENCRYPTION_KEY=

# Transactional email (Hostinger Email)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=info@khatupay.com
MAIL_PASS=your_mailbox_password
MAIL_FROM=info@khatupay.com
MAIL_FROM_NAME=Khatu Pay
MAIL_REPLY_TO=info@khatupay.com
SUPPORT_EMAIL=info@khatupay.com

# APITxT SMS OTP. Standard delivery uses https://apitxt.com/api/sendOTP when
# APITXT_OTP_SEND_URL is empty. Sender/template are optional.
# non-DLT transactional routes.
APITXT_AUTH_KEY=
APITXT_BASE_URL=https://apitxt.com
APITXT_DEFAULT_COUNTRY=91
APITXT_OTP_SEND_URL=https://apitxt.com/api/sendOTP
APITXT_OTP_HTTP_METHOD=POST
APITXT_OTP_SENDER_ID=
APITXT_OTP_TEMPLATE_ID=

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Partner / Aggregator Sub-Merchant Onboarding (server-side only)
# Use the Production credentials from Partner Dashboard for live onboarding.
RAZORPAY_PARTNER_CLIENT_ID=
RAZORPAY_PARTNER_CLIENT_SECRET=
RAZORPAY_PARTNER_MODE=live
RAZORPAY_PARTNER_WEBHOOK_SECRET=
RAZORPAY_PARTNER_WEBHOOK_URL=https://khatupay.com/api/webhooks/razorpay/partner
RAZORPAY_PARTNER_OAUTH_REDIRECT_URI=https://khatupay.com/api/merchant-business/razorpay/oauth/callback

CLUBAPI_TOKEN=your_clubapi_token
CLUBAPI_CALLBACK_ID=your_clubapi_callback_id
# Optional: set this and register the callback in the ClubAPI panel as
# https://<your-domain>/api/callback/clubapi?key=<this value>
# Callbacks are always re-verified with ClubAPI before any refund.
CLUBAPI_CALLBACK_SECRET=
CLUBAPI_FUND_REQUEST_URL=https://clubapi.in/account/data_post.php?act=buyerFundRequestRequest
CLUBAPI_FUND_REQUEST_LIST_URL=https://clubapi.in/account/data_post.php?act=buyerFundRequest
CLUBAPI_PANEL_COOKIE=

SIGNCARE_BASE_URL=https://ext.signcare.io
SIGNCARE_API_KEY=your_signcare_production_api_key
SIGNCARE_APP_ID=your_signcare_app_id
SIGNCARE_WEBHOOK_URL=https://khatupay.com/api/signcare/webhook
SIGNCARE_RETURN_URL=https://khatupay.com/loan-signing-complete
# Enable only after SignCare confirms WealthSync/AA entitlement.
SIGNCARE_WEALTHSYNC_ENABLED=false
PUBLIC_SERVER_IP=72.60.102.36

VELXAPAY_SIGNING_KEY=your_velxapay_signing_key
VELXAPAY_LINK_KEY=your_velxapay_link_key
VELXAPAY_PAYIN_URL=https://velxapay.com/v2/payment/initiate
VELXAPAY_PAYOUT_URL=https://velxapay.com/v2/amount/withdraw
VELXAPAY_VERIFY_URL=https://velxapay.com/v2/payment/verify
VELXAPAY_WEBHOOK_SECRET=replace_with_dashboard_webhook_secret
MERCHANT_PAY_PUBLIC_URL=https://khatupay.com/pay/merchant
VELXAPAY_WEBHOOK_URL=https://khatupay.com/api/payments/velxapay/webhook
VELXAPAY_SUCCESS_URL=https://khatupay.com/payment-success
VELXAPAY_FAILED_URL=https://khatupay.com/payment-failed
VELXAPAY_PENDING_URL=https://khatupay.com/payment-pending
VELXAPAY_TIMEOUT_URL=https://khatupay.com/payment-timeout
VELXAPAY_REFUND_URL=https://khatupay.com/refund-success

# Firebase Admin (push notifications): path to the service account JSON of the SAME project as the app's google-services.json
FIREBASE_SERVICE_ACCOUNT=./src/firebase-service-account.json
FIREBASE_PROJECT_ID=
